# Copy to .env and chmod 600 .env. Never commit the real values.

# Directory on the server that holds the books; it becomes its own Git repository for backups.
LEDGER_DATA_DIR=/home/lucius7/ledger-data
LEDGER_MAIN_FILE=main.beancount
# Owner of LEDGER_DATA_DIR (id -u / id -g); the containers run as this user.
LEDGER_UID=1000
LEDGER_GID=1000
FAVA_PORT=5000

# Cloudflare Tunnel token. In Zero Trust, the public hostname fava.lucius7.dev points at http://fava:5000
# and stays behind a Cloudflare Access policy.
CLOUDFLARE_TUNNEL_TOKEN=

# lucius7.dev panel: the token equals the panel's LEDGER_INGEST_TOKEN secret. Empty disables the push.
LEDGER_PANEL_INGEST_URL=https://lucius7.dev/api/v1/ingest/ledger
LEDGER_PANEL_INGEST_TOKEN=

# Private backup repository. Its deploy key (write access) goes in secrets/ledger_backup_key.
# Empty keeps the history in the data directory only.
LEDGER_BACKUP_REMOTE=git@github.com:xw7qwq/ledger-data.git
LEDGER_JOBS_INTERVAL=900
